{
  "name": "evidentai",
  "private": true,
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "build:cli": "pnpm --filter @evidentai/cli build",
    "build:gateway": "pnpm --filter @evidentai/gateway build",
    "build:shield": "pnpm --filter @evidentai/shield build",
    "dev": "pnpm --filter @evidentai/cli dev",
    "dev:gateway": "pnpm --filter @evidentai/gateway dev",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "test:detectors": "pnpm --filter @evidentai/detectors test",
    "test:cli": "pnpm --filter @evidentai/cli test",
    "test:gateway": "pnpm --filter @evidentai/gateway test",
    "test:shield": "pnpm --filter @evidentai/shield test",
    "test:api": "cd apps/api && python -m pytest -q",
    "lint": "pnpm -r --filter \"./packages/*\" --if-present lint",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "clean": "pnpm -r --filter \"./packages/*\" --if-present clean",
    "gateway:start": "pnpm --filter @evidentai/gateway start"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
